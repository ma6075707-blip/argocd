
apiVersion: argoproj.io/v1alpha1
kind: Application

metadata:
  name: sample-argocd-app
  namespace: argocd

spec:
  project: default

  source:
    repoURL: https://github.com/ma6075707-blip/argocd.git
    targetRevision: main
    path: overlays/dev

  destination:
    server: https://kubernetes.default.svc
    namespace: default 

  syncPolicy:
    automated:
      prune: true
      selfHeal: true

    syncOptions:
      - CreateNamespace=true
